<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/sp_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- ENCABEZADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="14dp"
            android:background="@drawable/bg_header"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SMARTPARKING"
                android:textColor="@color/sp_white"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sistema de estacionamiento inteligente"
                android:textColor="@color/sp_white"
                android:textSize="12sp"
                android:gravity="center" />

        </LinearLayout>

        <!-- ESTADO DE CONEXIÓN -->
        <TextView
            android:id="@+id/txtConexion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="● Modo simulación | IoT sin conectar"
            android:textColor="@color/sp_gray"
            android:textSize="12sp"
            android:gravity="center"
            android:padding="5dp"
            android:layout_marginBottom="8dp" />

        <!-- DISPONIBILIDAD -->
        <TextView
            android:id="@+id/txtEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ESTACIONAMIENTO DISPONIBLE"
            android:textColor="@color/sp_white"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="12dp"
            android:background="@color/sp_green"
            android:layout_marginBottom="10dp" />

        <!-- SIMULACIÓN DE SENSORES -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SIMULACIÓN DE SENSORES"
                android:textColor="@color/sp_orange"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="5dp" />

            <Switch
                android:id="@+id/switchEntrada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vehículo en la entrada"
                android:textColor="@color/sp_dark"
                android:minHeight="42dp"
                android:padding="5dp" />

            <Switch
                android:id="@+id/switchEstacionamiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Vehículo estacionado"
                android:textColor="@color/sp_dark"
                android:minHeight="42dp"
                android:padding="5dp" />

            <Switch
                android:id="@+id/switchNoche"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Modo noche"
                android:textColor="@color/sp_dark"
                android:minHeight="42dp"
                android:padding="5dp" />

        </LinearLayout>

        <!-- VISUALIZACIÓN DEL SISTEMA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CONTROL DE ACCESO"
            android:textColor="@color/sp_dark"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="top"
            android:layout_marginBottom="10dp">

            <!-- TARJETA DE LA BARRERA -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.5"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:background="@drawable/bg_card"
                android:layout_marginEnd="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BARRERA"
                    android:textColor="@color/sp_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="175dp"
                    android:background="#E5E7EB"
                    android:clipChildren="false"
                    android:clipToPadding="false">

                    <!-- SUELO -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_gravity="bottom"
                        android:background="#374151" />

                    <!-- BASE -->
                    <View
                        android:layout_width="24dp"
                        android:layout_height="55dp"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="@color/sp_dark" />

                    <!-- BRAZO ANIMADO -->
                    <LinearLayout
                        android:id="@+id/brazoBarrera"
                        android:layout_width="140dp"
                        android:layout_height="12dp"
                        android:layout_gravity="bottom|start"
                        android:layout_marginStart="24dp"
                        android:layout_marginBottom="55dp"
                        android:orientation="horizontal"
                        android:background="@color/sp_white">

                        <View
                            android:layout_width="28dp"
                            android:layout_height="match_parent"
                            android:background="@color/sp_red" />

                        <View
                            android:layout_width="28dp"
                            android:layout_height="match_parent"
                            android:background="@color/sp_white" />

                        <View
                            android:layout_width="28dp"
                            android:layout_height="match_parent"
                            android:background="@color/sp_red" />

                        <View
                            android:layout_width="28dp"
                            android:layout_height="match_parent"
                            android:background="@color/sp_white" />

                        <View
                            android:layout_width="28dp"
                            android:layout_height="match_parent"
                            android:background="@color/sp_red" />

                    </LinearLayout>

                </FrameLayout>

                <TextView
                    android:id="@+id/txtEstadoBarreraVisual"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Barrera cerrada"
                    android:textColor="@color/sp_gray"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

            <!-- TARJETA DEL SEMÁFORO -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:background="@drawable/bg_card"
                android:layout_marginStart="5dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SEMÁFORO"
                    android:textColor="@color/sp_dark"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="175dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="9dp"
                    android:background="@drawable/bg_semaforo">

                    <View
                        android:id="@+id/luzRoja"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_luz_semaforo"
                        android:layout_marginBottom="9dp" />

                    <View
                        android:id="@+id/luzAmarilla"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_luz_semaforo"
                        android:layout_marginBottom="9dp" />

                    <View
                        android:id="@+id/luzVerde"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_luz_semaforo" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txtSemaforo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Semáforo: Verde"
                    android:textColor="@color/sp_gray"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:layout_marginTop="8dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- MONITOREO DE SENSORES -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MONITOREO DEL SISTEMA"
            android:textColor="@color/sp_dark"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/txtEntrada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sensor entrada: Sin vehículo"
            android:textColor="@color/sp_dark"
            android:textSize="14sp"
            android:padding="12dp"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/txtEstacionamiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sensor plaza: Libre"
            android:textColor="@color/sp_dark"
            android:textSize="14sp"
            android:padding="12dp"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/txtBarrera"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Barrera: Cerrada (0°)"
            android:textColor="@color/sp_dark"
            android:textSize="14sp"
            android:padding="12dp"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/txtLuz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Luminosidad: Día"
            android:textColor="@color/sp_dark"
            android:textSize="14sp"
            android:padding="12dp"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/txtIluminacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LED entrada: Apagado"
            android:textColor="@color/sp_dark"
            android:textSize="14sp"
            android:padding="12dp"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="10dp" />

        <!-- REINICIAR -->
        <Button
            android:id="@+id/btnReiniciar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="REINICIAR SIMULACIÓN"
            android:layout_marginBottom="12dp" />


        <!-- CERRAR SESIÓN -->
        <Button
            android:id="@+id/btnCerrarSesion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CERRAR SESIÓN"
            android:backgroundTint="@color/sp_dark"
            android:textColor="@color/sp_white"
            android:layout_marginBottom="12dp" />


        <!-- PIE DE PÁGINA -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SmartParking | Prototipo IoT"
            android:textColor="@color/sp_gray"
            android:textSize="11sp"
            android:gravity="center"
            android:padding="8dp" />

    </LinearLayout>

</ScrollView>
